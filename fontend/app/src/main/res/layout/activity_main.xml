<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- TITLE -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PARISARA CYCLE"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#2E7D32"
            android:layout_gravity="center"
            android:paddingBottom="20dp" />

        <!-- SEARCH -->

        <EditText
            android:id="@+id/etRoute"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter destination"
            android:background="#FFFFFF"
            android:padding="12dp" />

        <!-- BUTTONS -->

        <Button
            android:id="@+id/btnSafeRoute"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Find Safe Route"
            android:layout_marginTop="15dp"
            android:backgroundTint="#5E35B1" />

        <Button
            android:id="@+id/btnReportDanger"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Report Dangerous Area"
            android:layout_marginTop="10dp"
            android:backgroundTint="#C62828" />

        <!-- MAP TITLE -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Safe Route Map"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:paddingTop="30dp" />

        <!-- REAL WEB MAP -->

        <WebView
            android:id="@+id/webMap"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:layout_marginTop="10dp" />

        <!-- ECO STATS -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌱 Eco Stats"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:paddingTop="30dp" />

        <TextView
            android:id="@+id/tvEcoStats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="You saved 0g CO2 today"
            android:textSize="18sp"
            android:paddingTop="10dp" />

        <!-- PIT STOPS -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛠 Nearby Pit Stops"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:paddingTop="30dp" />

        <TextView
            android:id="@+id/tvPitStops"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="• Cycle Repair Shop&#10;• Water Point"
            android:textSize="18sp"
            android:paddingTop="10dp" />

        <!-- BUDDY -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👥 Cycling Buddy"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:paddingTop="30dp" />

        <TextView
            android:id="@+id/tvBuddy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No cycling buddies nearby"
            android:textSize="18sp"
            android:paddingTop="10dp"
            android:paddingBottom="30dp" />

    </LinearLayout>

</ScrollView>